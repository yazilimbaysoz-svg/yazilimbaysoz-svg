<style id="naztech-catalog-16x9">
  .service-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 16px;
    border: 1px solid rgba(212, 175, 55, 0.28);
    background: #0b0e14;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
  }
  .service-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .service-card:hover .service-card__media img,
  .hizmet-kart:hover .service-card__media img,
  [data-service]:hover .service-card__media img,
  [data-catalog]:hover .service-card__media img,
  [data-catalog]:focus-visible .service-card__media img {
    transform: scale(1.05);
  }
  /* Legacy WebGL/3D surfaces are not part of the delivered experience. */
  #hizmetModal canvas,
  .modal-3d-wrap,
  .webgl-container,
  [data-3d-viewer] {
    display: none !important;
  }
  #hizmetModal .modal__gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding: 20px 24px 6px;
    background: rgba(3, 5, 8, 0.32);
  }
  #hizmetModal .modal__gallery:empty { display: none; }
  #hizmetModal .modal__figure {
    flex: 1 1 30%;
    max-width: calc(33.333% - 10px);
    margin: 0;
  }
  #hizmetModal .modal__figure:first-child {
    flex: 1 1 100%;
    max-width: 100%;
  }
  #hizmetModal .modal__figure img {
    width: 100% !important;
    aspect-ratio: 16 / 9 !important;
    height: auto !important;
    object-fit: cover !important;
    border-radius: 12px !important;
    cursor: default !important;
    transform: none !important;
    filter: none !important;
  }
  #hizmetModal .modal__caption { padding: 8px 4px 2px; }
  #hizmetModal .btn--whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px 20px;
    border-radius: 12px;
    background: #25d366;
    color: #052e16;
    font-weight: 800;
    text-decoration: none;
    transition: filter 0.2s ease, transform 0.2s ease;
  }
  #hizmetModal .btn--whatsapp:hover,
  #hizmetModal .btn--whatsapp:focus-visible {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }
  @media (max-width: 720px) {
    #hizmetModal .modal__figure,
    #hizmetModal .modal__figure:first-child {
      flex: 1 1 100%;
      max-width: 100%;
    }
  }
</style>




</head>
