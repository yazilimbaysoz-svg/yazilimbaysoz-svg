  <script>
    const reveals = document.querySelectorAll('.reveal');
    const onScroll = () => reveals.forEach(el => { if (el.getBoundingClientRect().top < window.innerHeight - 60) el.classList.add('active'); });
    window.addEventListener('scroll', onScroll); onScroll();
  </script>
  <script>window.addEventListener("DOMContentLoaded",function(){var p=document.getElementById("nztPreloader");if(p){setTimeout(function(){p.style.transition="opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1)";p.style.opacity="0";p.style.pointerEvents="none";setTimeout(function(){p.remove();},580);},1150);}});</script>
