<style id="naztech-clean-overrides">
.partner-marquee__item{padding:14px 28px!important;gap:18px!important;min-height:84px!important}
.partner-marquee__chip{background:transparent!important;border:none!important;padding:0!important;min-height:auto!important;display:inline-flex!important;align-items:center!important;justify-content:center!important}
.partner-marquee__logo,.partner-marquee__mark{height:54px!important;width:auto!important;max-width:240px!important;object-fit:contain!important;background:transparent!important;border-radius:8px!important}
.partner-marquee__showcase,#tez3dModal,#webgl3dCanvas,.tez3d-stage,[data-3d-viewer]{display:none!important}
</style>
