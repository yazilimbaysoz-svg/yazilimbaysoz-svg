    if (window.tailwind) {
      window.tailwind.config = {
        theme: {
          extend: {
            colors: { obsidian: '#0d0e11', carbon: '#15171c', gold: { light: '#f3d478', DEFAULT: '#d4af37', dark: '#9e7f1e' } },
