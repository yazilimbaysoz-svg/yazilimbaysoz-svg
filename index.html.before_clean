  <style>
    body { background-color: #0d0e11; color: #f4f4f5; overflow-x: hidden; }
    .gold-glow { box-shadow: 0 0 25px rgba(212, 175, 55, 0.25); }
    .card-hover { transition: border-color 0.35s ease, box-shadow 0.35s ease; }
    .card-hover:hover { border-color: #d4af37; box-shadow: 0 12px 30px -8px rgba(212, 175, 55, 0.35); }
    .reveal { opacity: 0; translate: 0 24px; transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1), translate 0.7s ease-out; }
    .reveal.active { opacity: 1; translate: 0 0; }
  </style>
